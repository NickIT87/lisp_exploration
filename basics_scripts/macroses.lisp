
;;; ==================================================
;;; macroses.lisp
;;; Пример использования макросов в Common Lisp
;;; Запуск: sbcl --script macroses.lisp
;;; ==================================================


;;; --------------------------------------------------
;;; 1. WHEN-POSITIVE
;;; Выполняет тело макроса, если число больше нуля.
;;;
;;; number   — выражение с числом;
;;; &body body — все формы кода внутри макроса;
;;; ,number  — вставляет выражение number в шаблон;
;;; ,@body   — вставляет все формы из body.
;;; --------------------------------------------------

(defmacro when-positive (number &body body)
  `(when (> ,number 0)
     ,@body))


;;; --------------------------------------------------
;;; 2. UNLESS-NIL
;;; Выполняет тело, если значение не равно NIL.
;;;
;;; Подходит для проверки строк, списков и других
;;; значений, где NIL означает отсутствие значения.
;;; --------------------------------------------------

(defmacro unless-nil (value &body body)
  `(unless (null ,value)
     ,@body))


;;; --------------------------------------------------
;;; 3. INCF-BY
;;; Увеличивает переменную на заданную величину.
;;;
;;; Например:
;;; (let ((score 100))
;;;   (incf-by score 25))
;;; После выполнения score будет равен 125.
;;; --------------------------------------------------

(defmacro incf-by (variable amount)
  `(incf ,variable ,amount))


;;; --------------------------------------------------
;;; 4. WITH-TIMING
;;; Измеряет время выполнения блока кода.
;;;
;;; get-internal-real-time — получает показание часов;
;;; unwind-protect — гарантирует выполнение завершающей
;;; формы даже при выходе из тела через исключение
;;; или другой нелокальный переход;
;;; internal-time-units-per-second — число единиц
;;; внутреннего времени в секунде.
;;; --------------------------------------------------

(defmacro with-timing (&body body)
  `(let ((start-time (get-internal-real-time)))
     (unwind-protect
          (progn
            ,@body)
       (format t "~&Время выполнения: ~,6F секунд~%"
               (/ (- (get-internal-real-time)
                     start-time)
                  (float internal-time-units-per-second))))))


;;; --------------------------------------------------
;;; 5. MAIN
;;; Основная функция, демонстрирующая все четыре
;;; макроса.
;;; --------------------------------------------------

(defun main ()

  ;;; Пример 1: WHEN-POSITIVE
  (format t "~%=== WHEN-POSITIVE ===~%")

  (let ((number 10))
    (when-positive number
      (format t "Число ~a положительное.~%" number)
      (format t "Дополнительный код выполнен.~%")))

  ;; Для отрицательного числа тело не выполняется.
  (let ((number -5))
    (when-positive number
      (format t "Эта строка не появится.~%")))


  ;;; Пример 2: UNLESS-NIL
  (format t "~%=== UNLESS-NIL ===~%")

  (let ((username "Alex"))
    (unless-nil username
      (format t "Пользователь: ~a~%" username)))

  ;; NIL означает отсутствие значения, поэтому
  ;; тело этого макроса не выполняется.
  (let ((username nil))
    (unless-nil username
      (format t "Эта строка не появится.~%")))


  ;;; Пример 3: INCF-BY
  (format t "~%=== INCF-BY ===~%")

  (let ((score 100))
    (format t "До изменения: ~a~%" score)
    (incf-by score 25)
    (format t "После изменения: ~a~%" score))


  ;;; Пример 4: WITH-TIMING
  (format t "~%=== WITH-TIMING ===~%")

  (with-timing
    (let ((sum 0))
      ;; Складываем числа от 0 до 999999.
      (dotimes (i 1000000)
        (incf sum i))

      (format t "Сумма: ~a~%" sum)))


  ;;; Завершение программы
  (format t "~%Программа завершена.~%"))


;;; --------------------------------------------------
;;; Запуск программы
;;; --------------------------------------------------

(main)

